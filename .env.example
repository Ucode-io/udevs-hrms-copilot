PORT=8080
# Comma-separated origins allowed to open the SSE stream (the HRMS admin SPA).
CORS_ORIGINS=http://localhost:5173,http://localhost:5199,https://hrms.ucode.co

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max. Sonnet 5 defaults to high.
COPILOT_EFFORT=high
COPILOT_MAX_CONCURRENT_STREAMS=2

# ── ucode ───────────────────────────────────────────────────────────────────
UCODE_BASE_URL=https://api.admin.u-code.io
# Fallback project. The panel sends its own in a Project-Id header; this is
# what a request without one gets, and where the Copilot keeps its own rows.
UCODE_PROJECT_ID=9a462573-ce11-4288-928a-a6ba754b6998
UCODE_ENVIRONMENT_ID=2f73835f-3a29-46c8-951e-75119db9bfc0
# Service key used ONLY for the copilot's own bookkeeping tables
# (copilot_conversations / copilot_audit). Never for user data.
UCODE_SERVICE_API_KEY=
# Role id that marks a user_base row as an employee (mirrors VITE_EMPLOYEE_ROLE_ID).
HRMS_EMPLOYEE_ROLE_ID=
# HRMS cloud-function gateway backing run_report.
HRMS_REPORTS_FUNCTION=udevs-hrms-reports

# ── Telegram bot ────────────────────────────────────────────────────────────
# The same bot that sends HRMS notifications. Leave empty and the bot surface is
# simply off — the panel is unaffected.
TELEGRAM_BOT_TOKEN=
# Any long random string. Handed to Telegram once by set-webhook.ts and echoed
# back on every delivery; the webhook URL is public, so this is the only proof
# an update came from Telegram. Empty means /telegram/webhook refuses outright.
TELEGRAM_WEBHOOK_SECRET=
# Cloud function that owns group and phone binding. Updates about either are
# forwarded to it untouched.
HRMS_HICKVISION_FUNCTION=udevs-hrms-hickvision
# Base URL of the HRMS panel, used for the "open in HRMS" buttons. Without it
# those buttons are dropped — Telegram rejects a relative url.
HRMS_WEB_URL=https://hrms.ucode.co
